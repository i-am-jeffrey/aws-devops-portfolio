{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IAMRoleAndPolicyManagementScoped",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion"
      ],
      "Resource": [
        "arn:aws:iam::411714852651:role/segment1-app-*",
        "arn:aws:iam::411714852651:policy/segment1-app-*",
        "arn:aws:iam::411714852651:role/default-eks-node-group-*"
      ]
    },
    {
      "Sid": "OIDCProviderForIRSAAndGitHubActions",
      "Effect": "Allow",
      "Action": [
        "iam:CreateOpenIDConnectProvider",
        "iam:DeleteOpenIDConnectProvider",
        "iam:GetOpenIDConnectProvider",
        "iam:TagOpenIDConnectProvider"
      ],
      "Resource": [
        "arn:aws:iam::411714852651:oidc-provider/oidc.eks.ap-southeast-1.amazonaws.com/id/*",
        "arn:aws:iam::411714852651:oidc-provider/token.actions.githubusercontent.com"
      ]
    },
    {
      "Sid": "ListOIDCProvidersAccountWide",
      "Effect": "Allow",
      "Action": "iam:ListOpenIDConnectProviders",
      "Resource": "*"
    },
    {
      "Sid": "PassRoleScopedToEKSAndEC2Only",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::411714852651:role/segment1-app-*",
        "arn:aws:iam::411714852651:role/default-eks-node-group-*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "eks.amazonaws.com",
            "ec2.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ReadOwnSSOSessionRole",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::411714852651:role/aws-reserved/sso.amazonaws.com/*"
    },
    {
      "Sid": "CheckServiceLinkedRoleExists",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": [
        "arn:aws:iam::411714852651:role/aws-service-role/*",
        "arn:aws:iam::411714852651:role/AWSServiceRoleFor*"
      ]
    },
    {
      "Sid": "CreateServiceLinkedRoleScoped",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::411714852651:role/aws-service-role/*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "eks.amazonaws.com",
            "eks-nodegroup.amazonaws.com",
            "elasticloadbalancing.amazonaws.com",
            "spot.amazonaws.com"
          ]
        }
      }
    }
  ]
}
